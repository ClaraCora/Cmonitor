[Unit]
Description=Report Cmonitor backup schedule and inventory
After=monitor-hub.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/monitor/backup.py --db /opt/monitor/data/monitor.db --report-status
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/monitor/data
RestrictAddressFamilies=AF_UNIX
